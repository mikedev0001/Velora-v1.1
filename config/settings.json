{
  "version": "2.0.0",
  "ai_settings": {
    "learning_enabled": true,
    "threat_detection": true,
    "optimization_enabled": true,
    "model_retrain_interval": 24
  },
  "storage": {
    "default_locations": {
      "servers": "data/servers",
      "backups": "data/backups",
      "logs": "data/logs",
      "temp": "data/temp"
    },
    "auto_cleanup": true,
    "cleanup_interval": 7
  },
  "servers": {
    "default_ports": {
      "http": 8080,
      "https": 8443,
      "tcp": 9000,
      "udp": 9001
    },
    "auto_start": false,
    "max_instances": 5
  },
  "applications": {
    "auto_import": true,
    "launch_delay": 2,
    "monitor_resources": true
  },
  "ui": {
    "theme": "dark",
    "auto_save": true,
    "refresh_interval": 10
  }
}